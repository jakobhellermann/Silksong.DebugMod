<Project>
    <!--
    Generate one assembly per game version.
        alias      game version    framework       modding api
        hk1221     1.2.2.1         net35           42hksr
        hk1315     1.3.1.5         net35           74hksr
        hk1432     1.4.3.2         net35           74hksr
        hk1578     1.5.78.11833    net472          77
        hk1512620  1.5.12620       netstandard2.1  78
        silksong   *               netstandard2.1  BepInEx

    HK aliases can be built with a -bepinex suffix as well.
    -->

    <PropertyGroup>
        <HkGameLibsPackageVersion Condition="'$(HkGameLibsPackageVersion)' == ''">1.0.1</HkGameLibsPackageVersion>
        <GameTarget>$(TargetFramework.Replace('-bepinex', ''))</GameTarget>
        <ModLoader Condition="'$(GameTarget)' == 'silksong' Or '$(GameTarget)' != '$(TargetFramework)'">BepInEx</ModLoader>
        <ModLoader Condition="'$(ModLoader)' == ''">ModdingApi</ModLoader>
        <!-- define constants like HK1221, SILKSONG and BEPINEX, MODDINGAPI -->
        <DefineConstants>$(DefineConstants);$(GameTarget.ToUpper());$(ModLoader.ToUpper())</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GameTarget)' == 'hk1221'">
        <HollowKnightVersion>1.2.2.1</HollowKnightVersion>
        <ModdingApiVersion>42hksr</ModdingApiVersion>
        <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
        <ModsLayout>flat</ModsLayout>
        <NoUnityModules>true</NoUnityModules>
        <RepackDependencies>true</RepackDependencies>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GameTarget)' == 'hk1315'">
        <HollowKnightVersion>1.3.1.5</HollowKnightVersion>
        <ModdingApiVersion>74hksr</ModdingApiVersion>
        <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
        <ModsLayout>subdirectory</ModsLayout>
        <NoUnityModules>true</NoUnityModules>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GameTarget)' == 'hk1432'">
        <HollowKnightVersion>1.4.3.2</HollowKnightVersion>
        <ModdingApiVersion>74hksr</ModdingApiVersion>
        <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
        <!-- v74 backport loads subdirectories; the v60 API does not -->
        <ModsLayout>subdirectory</ModsLayout>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GameTarget)' == 'hk1578'">
        <HollowKnightVersion>1.5.78.11833</HollowKnightVersion>
        <ModdingApiVersion>77</ModdingApiVersion>
        <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
        <ModsLayout>subdirectory</ModsLayout>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GameTarget)' == 'hk1512620'">
        <HollowKnightVersion>1.5.12620</HollowKnightVersion>
        <ModdingApiVersion>78</ModdingApiVersion>
        <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>v2.1</TargetFrameworkVersion>
        <ModsLayout>subdirectory</ModsLayout>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GameTarget)' == 'silksong'">
        <SilksongVersion>*-*</SilksongVersion>
        <!-- <ModdingApiVersion>78</ModdingApiVersion> -->
        <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>v2.1</TargetFrameworkVersion>
        <ModsLayout>subdirectory</ModsLayout>
    </PropertyGroup>

    <PropertyGroup Condition="'$(HollowKnightVersion)' != ''">
        <TargetFrameworkMoniker>$(TargetFrameworkIdentifier),Version=$(TargetFrameworkVersion)</TargetFrameworkMoniker>
    </PropertyGroup>

    <ItemGroup Condition="'$(HollowKnightVersion)' != ''">
        <!--
        NU1601: aliases sharing an effective framework collapse into one dependency group, while the restore graph
        itself stays per alias.
        -->
        <PackageReference Include="HollowKnight.GameLibs"
                          Version="[$(HkGameLibsPackageVersion)-hollowknight.$(HollowKnightVersion).api$(ModdingApiVersion)]"
                          PrivateAssets="all"
                          NoWarn="NU1601"
                          ExcludeAssets="$(ExcludeAssetsIfLocalReference)"/>
    </ItemGroup>

</Project>

